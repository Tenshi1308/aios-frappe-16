# Contoh file environment untuk runner E2E Flow Utama (scripts/e2e_flow_utama.py)
# Salin file ini ke scripts/e2e.env dan sesuaikan nilainya.
# PERINGATAN: JANGAN PERNAH COMMIT file scripts/e2e.env yang berisi kredensial asli!

# Path absolut ke root direktori Frappe bench
E2E_BENCH_ROOT=/home/samue/mybench-v16

# Nama site developer (control plane) tempat Lead pendaftar dicatat
E2E_DEV_SITE=aios-v16.localhost

# Password root MariaDB untuk pembuatan dan penghapusan site uji
E2E_DB_ROOT_PASSWORD=

# Password Administrator Frappe untuk site uji yang baru dibuat
E2E_ADMIN_PASSWORD=admin

# Prefix wajib untuk site uji sekali pakai (guard: hanya site berawalan prefix ini yang boleh di-drop)
E2E_SITE_PREFIX=aios-e2e-tmp

# Port webserver bench (opsional, default 8001)
E2E_WEB_PORT=8001

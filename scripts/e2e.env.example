# Contoh konfigurasi runner E2E Flow Utama (scripts/e2e_flow_utama.py).
# Salin ke scripts/e2e.env lalu isi. File e2e.env di-.gitignore: JANGAN di-commit.
# Semua variabel WAJIB kecuali yang ditandai opsional; yang kosong -> skrip gagal eksplisit.
# Nilai di bawah hanya contoh format, bukan kredensial.

# Root bench (berisi folder sites/ dan apps/)
E2E_BENCH_ROOT=/path/ke/bench

# Site developer (control plane). Harus sudah punya "aios_site_role": "developer" di site_config.json.
E2E_DEV_SITE=nama-site-developer.localhost

# URL web bench; site dipilih lewat Host header (dns_multitenant). Samakan dengan webserver_port bench.
E2E_BASE_URL=http://127.0.0.1:8001

# Awalan nama site uji. Hanya site berawalan "<prefix>-" yang boleh di-drop skrip.
E2E_SITE_PREFIX=aios-e2e

# Data wizard; mata uang & zona waktu diturunkan Frappe dari negara.
E2E_COUNTRY=Indonesia
E2E_LANGUAGE=en
E2E_CHART_OF_ACCOUNTS=Standard
E2E_EMAIL_DOMAIN=example.test

# Opsional: path executable bench (bila tidak ada di PATH)
# E2E_BENCH_BIN=/path/ke/bench

# Opsional: password root MariaDB untuk new-site/drop-site. Bila kosong, bench memakai kredensial
# root dari konfigurasinya atau gagal. Catatan: nilai ini terlihat di daftar proses saat perintah jalan.
# E2E_DB_ROOT_PASSWORD=
